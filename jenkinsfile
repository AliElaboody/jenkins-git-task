pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'if exist index.html (echo index.html exists) else (exit 1)'
                sh 'if exist README.md (echo README.md exists) else (exit 1)'
            }
        }

        stage('Test') {
            steps {
                sh 'findstr /C:"Hello from Jenkins!" index.html'
            }
        }

        stage('Success') {
            steps {
                echo "Pipeline completed successfully!"
            }
        }
    }
}
