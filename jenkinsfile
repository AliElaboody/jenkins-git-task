pipeline {
    agent any


    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'if exist index.html (echo index.html exists) else (exit 1)'
                echo 'if exist README.md (echo README.md exists) else (exit 1)'
            }
        }

        stage('Test') {
            steps {
                echo 'findstr /C:"Hello from Jenkins!" index.html'
            }
        }

        stage('Success') {
            steps {
                echo "Pipeline completed successfully!--Trigger_Test_update"
            }
        }
    }
}
